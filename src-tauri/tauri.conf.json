{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shoot Studio",
  "version": "0.1.0",
  "identifier": "com.shootstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shoot Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#0B0C0E"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/**", "$HOME/**", "**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Photography",
    "shortDescription": "Lightroom-stijl RAW editor en AI culling studio",
    "longDescription": "Shoot Studio combineert snelle RAW/CR3 preview-extractie, automatische scherpte- en duplicaatanalyse, niet-destructieve kleurbewerking, interactief watermerken en multithreaded batch-export.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
